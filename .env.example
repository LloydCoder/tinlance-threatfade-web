# Public site configuration
NEXT_PUBLIC_SITE_URL=https://threatfade.com

# Server-side ThreatFade engine endpoint. Never expose private credentials here.
THREATFADE_API_URL=

# Auth.js / OIDC. All values are server-only.
NEXTAUTH_SECRET=
THREATFADE_OIDC_ISSUER=
THREATFADE_OIDC_CLIENT_ID=
THREATFADE_OIDC_CLIENT_SECRET=
THREATFADE_OIDC_TOKEN_URL=
